# 1. API CONNECTION
# Kosongkan atau gunakan /api jika menggunakan Vite proxy lokal ke backend
# Atau arahkan langsung ke backend lokal: http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# 2. TENANT CONFIGURATION
VITE_TENANT_MODE=multi
VITE_DEFAULT_TENANT_SLUG=default

# 3. CLOUDINARY (Media & Image Uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 4. TAHFIDZ AI (Opsional - Groq Cloud API)
VITE_GROQ_API_KEY=your_groq_api_key

# 5. EXTERNAL QURAN/UMMAH API (Opsional - default fallback ke Ummah API)
VITE_UMMAH_API_URL=https://www.ummahapi.com/api
